#!/bin/bash
set -e
#
# gen-implib — build an import library (.a) from a shared library (.so).
#
# Ported from upstream images/base-linux64/gen-implib.sh (which the Docker image
# installed as /usr/bin/gen-implib). Used by the 45-x11 and 50-vaapi stages to
# produce static import libs for the X11/VAAPI shared libraries.
#
# Difference from upstream: the compiler/archiver come from $CC/$AR so that
# user compiler overrides (e.g. CC=clang) are honoured. Upstream hard-coded
# ${FFBUILD_CROSS_PREFIX}gcc / ${FFBUILD_CROSS_PREFIX}ar, which equals $CC/$AR
# in both of our toolchain modes anyway.
#
# Usage: gen-implib <libfoo.so.N> <libfoo.a>

if [[ $# != 2 ]]; then
    echo "usage: gen-implib <in.so> <out.a>" >&2
    exit 1
fi

IN="$1"
OUT="$2"
# Implib.so is a build tool, so it lives in the repo's managed-tools tree like
# the other buildtools; native/setup.sh installs it there.
IMPLIB_DIR="${FFBUILD_IMPLIB_DIR:-${FFBUILD_REPO_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}/.buildtools/implib}"

if [[ ! -f "$IMPLIB_DIR/implib-gen.py" ]]; then
    echo "gen-implib: $IMPLIB_DIR/implib-gen.py not found (run native/setup.sh)" >&2
    exit 1
fi

TMPDIR="$(mktemp -d)"
trap 'rm -rf "$TMPDIR"' EXIT
cd "$TMPDIR"

# Implib's --target names the *target* ABI; upstream ships one script per
# image. Derive it from the toolchain triple so cross builds get trampolines
# for the right architecture.
case "${FFBUILD_TOOLCHAIN:-$(uname -m)-linux-gnu}" in
    aarch64*) _implib_target=aarch64-linux-gnu ;;
    i686*)    _implib_target=i686-linux-gnu ;;
    x86_64*)  _implib_target=x86_64-linux-gnu ;;
    *)
        echo "gen-implib: unsupported toolchain triple '${FFBUILD_TOOLCHAIN:-}'" >&2
        exit 1
        ;;
esac

set -x
python3 "$IMPLIB_DIR/implib-gen.py" --target "$_implib_target" --dlopen --lazy-load --verbose "$IN"
# shellcheck disable=SC2086
"${CC:-${FFBUILD_CROSS_PREFIX}gcc}" $CFLAGS $STAGE_CFLAGS -Wa,--noexecstack -DIMPLIB_HIDDEN_SHIMS -c ./*.tramp.S ./*.init.c
"${AR:-${FFBUILD_CROSS_PREFIX}ar}" -rcs "$OUT" ./*.tramp.o ./*.init.o
