From 838d49568fd6f3c349d362701e1c83816f1bd15c Mon Sep 17 00:00:00 2001
From: Rainist7heta <thetamkz621@outlook.com>
Date: Tue, 10 Nov 2026 22:07:32 +0800
Subject: [PATCH] soxr: let the compiler driver choose the OpenMP runtime

libsoxr is built as a static library with -DWITH_OPENMP=ON, but soxr.pc.in
has no Libs.private entry. The stage appends a hard-coded "-lgomp" after
installation, which is only correct when the objects were compiled by GCC
(GOMP ABI). clang lowers OpenMP to the kmp ABI and needs libomp, so a
clang-built libsoxr fails to link with -lgomp.

FindOpenMP already determined the right answer by compiling and linking a
probe through the compiler driver with -fopenmp. Record that same option in
Libs.private: the consumer's driver expands it into -lgomp or -lomp and adds
the directory the runtime lives in (Debian keeps libomp.so under
/usr/lib/llvm-<N>/lib), so no library names or -L paths have to be guessed
here. The .pc is only consumed on the build host and is not part of the
packaged artifact.

When OpenMP was not found the entry stays empty, matching the serial objects.
---
 CMakeLists.txt | 8 ++++++++
 src/soxr.pc.in | 1 +
 2 files changed, 9 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ee48f6c..7097ed3 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,14 @@ if (WITH_OPENMP)
   if (OPENMP_FOUND)
     set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OpenMP_C_FLAGS}")
     set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${OpenMP_CXX_FLAGS}")
+    # The consumer's compiler driver expands -fopenmp into the runtime this
+    # build actually used (libgomp for GCC, libomp for clang) and adds the
+    # directory that runtime lives in.  Naming the libraries, or their -L
+    # paths, here would bake the build host's layout into the file and is
+    # wrong for any other compiler.
+    if (OpenMP_C_FOUND)
+      string (APPEND SOXR_PC_PRIVATE " -fopenmp")
+    endif()
     if (MINGW) # Is this still needed?
       set (CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} ${OpenMP_C_FLAGS}")
       set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${OpenMP_C_FLAGS}")
diff --git a/src/soxr.pc.in b/src/soxr.pc.in
index 69d225b..e86bac0 100644
--- a/src/soxr.pc.in
+++ b/src/soxr.pc.in
@@ -2,4 +2,5 @@ Name: ${PROJECT_NAME}
 Description: ${DESCRIPTION_SUMMARY}
 Version: ${PROJECT_VERSION}
 Libs: -L${LIB_INSTALL_DIR} -l${PROJECT_NAME}
+Libs.private:@SOXR_PC_PRIVATE@
 Cflags: -I${INCLUDE_INSTALL_DIR}
-- 
2.43.0

