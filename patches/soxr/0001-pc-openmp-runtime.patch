From: DeepSeek (via CodeBuddy CLI) <thetamkz621+ai@outlook.com>
Subject: [PATCH] soxr: derive the OpenMP runtime in soxr.pc from CMake

libsoxr is built as a static library with -DWITH_OPENMP=ON, but soxr.pc.in
has no Libs.private entry.  Upstream's stage appends a hard-coded "-lgomp"
after installation, which is only correct when the objects were compiled by
GCC (GOMP ABI).  Clang lowers OpenMP to the kmp ABI and needs libomp, so a
clang-built libsoxr fails to link with -lgomp.

Let CMake decide: FindOpenMP records the runtime names it used in
OpenMP_C_LIB_NAMES; put them into the template and drop the hard-coded value.
When OpenMP was not found the entry stays empty, matching the serial objects.

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ee48f6c..70d09f4 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -109,6 +109,16 @@ if (WITH_OPENMP)
   if (OPENMP_FOUND)
     set (CMAKE_C_FLAGS "${CMAKE_C_FLAGS} ${OpenMP_C_FLAGS}")
     set (CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} ${OpenMP_CXX_FLAGS}")
+    # pkg-config consumers of a *static* libsoxr must be told which OpenMP
+    # runtime the objects were compiled against.  Do not hard-code -lgomp:
+    # clang lowers OpenMP to the kmp ABI, whose runtime is libomp.
+    if (OpenMP_C_FOUND)
+      foreach (_soxr_omp ${OpenMP_C_LIB_NAMES})
+        if (NOT _soxr_omp STREQUAL "pthread")
+          string (APPEND SOXR_PC_PRIVATE " -l${_soxr_omp}")
+        endif()
+      endforeach()
+    endif()
     if (MINGW) # Is this still needed?
       set (CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} ${OpenMP_C_FLAGS}")
       set (CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} ${OpenMP_C_FLAGS}")
diff --git a/src/soxr.pc.in b/src/soxr.pc.in
index 69d225b..e86bac0 100644
--- a/src/soxr.pc.in
+++ b/src/soxr.pc.in
@@ -2,4 +2,5 @@ Name: ${PROJECT_NAME}
 Description: ${DESCRIPTION_SUMMARY}
 Version: ${PROJECT_VERSION}
 Libs: -L${LIB_INSTALL_DIR} -l${PROJECT_NAME}
+Libs.private:@SOXR_PC_PRIVATE@
 Cflags: -I${INCLUDE_INSTALL_DIR}
